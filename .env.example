# Esempio di variabili d'ambiente: non inserire credenziali reali in questo file.
# L'app non carica automaticamente un file .env.
# Usare un endpoint HTTPS completo compatibile con Chat Completions.
ASSISTENTE_AI_URL=https://api.example.com/v1/chat/completions
ASSISTENTE_AI_MODEL=nome-del-modello
ASSISTENTE_AI_API_KEY=
